# ---- C (https://github.com/github/gitignore/blob/main/C.gitignore) ----
#
# github/gitignore has no ESP-IDF template, so this is the nearest base. Almost
# everything it covers already lives under build/, but it also catches a stray
# object or map file left outside it.
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# ---- ESP-IDF ----

# Build tree, and the component manager's download cache.
/build/
/managed_components/
/.cache/

# Generated by `idf.py set-target`/`menuconfig` from sdkconfig.defaults plus
# sdkconfig.secrets. Not committed: it is a merge of the two, and it therefore
# contains the WiFi credentials in cleartext.
/sdkconfig
/sdkconfig.old

# WiFi credentials. sdkconfig.secrets.example is the committed template.
/sdkconfig.secrets

# Built by `pnpm build` in ../frontend and embedded into the image. Generated, and
# large, so it is rebuilt rather than tracked.
/main/web/index.html.gz
